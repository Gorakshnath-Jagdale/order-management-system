
CREATE DATABASE oms;
USE oms;
CREATE TABLE USER_DETAILS (
    USER_ID INT NOT NULL AUTO_INCREMENT,
    USER_NAME VARCHAR(100),
    LOGIN_ID VARCHAR(50),
    CONTACT_NUMBER VARCHAR(20),
    USER_PASS VARCHAR(200),
    IS_ACTIVE_USER BOOL,
    PRIMARY KEY (USER_ID)
);
CREATE TABLE CUSTOMER_DETAILS (
    CUSTOMER_ID INT NOT NULL AUTO_INCREMENT,
    CUSTOMER_NAME VARCHAR(100),
    CUSTOMER_EMAIL VARCHAR(100),
    CUSTOMER_ADDRESS VARCHAR(400),
    CUSTOMER_CONTACT VARCHAR(20),
    CREATED_BY VARCHAR(50),
    CREATED_DATE TIMESTAMP,
    MODIFIED_BY VARCHAR(50),
    MODIFIED_DATE TIMESTAMP,
    PRIMARY KEY (CUSTOMER_ID)
);
CREATE TABLE PRODUCT_DETAILS
(
PRODUCT_ID INT NOT NULL,
MFG_ITEM_NUMBER VARCHAR(50) UNIQUE COMMENT 'MFG item Nuber',
MANUFACTURER VARCHAR(50),
PRODUCT_DETAILS VARCHAR(200),
  CREATED_BY VARCHAR(50),
   CREATED_DATE TIMESTAMP,
   MODIFIED_BY VARCHAR(50),
    MODIFIED_DATE TIMESTAMP,
 PRIMARY KEY (PRODUCT_ID)
) ;
CREATE TABLE PRODUCT_ORDER_MANAGER (
    PRODUCT_ORDER_ID INT NOT NULL AUTO_INCREMENT,
    PO_NUMBER VARCHAR(25),
    PO_DATE TIMESTAMP COMMENT 'PO date',
    CUSTOMER_ID INT,
    CUSTOMER_ITEM_NO VARCHAR(50),
    PRODUCT_ID INT,

    CUSTOMER_REQ_DATE TIMESTAMP,
--     MFG_ITEM_NO VARCHAR(100),
--     ITEM_DETAILS VARCHAR(700),
--     MANUFACTURER VARCHAR(50),
    PRICE FLOAT(10 , 3 ),
    PO_QTY INT NOT NULL,
	SUPPLIED_QTY INT NOT NULL,
    PENDING_QTY INT NOT NULL,
    POV FLOAT(10 , 3 ),
    TOTAL_AMOUNT FLOAT(10 , 3 ),
    REMARKS VARCHAR(100),
    ORD_STATUS VARCHAR(45) NOT NULL COMMENT 'INPROGRESS/ON HOLD/CANCEL/AMENDMENT',
    CREATED_BY VARCHAR(50),
    CREATED_DATE TIMESTAMP,
    MODIFIED_BY VARCHAR(50),
    MODIFIED_DATE TIMESTAMP,
    PRIMARY KEY (PRODUCT_ORDER_ID),
    FOREIGN KEY (CUSTOMER_ID)
        REFERENCES CUSTOMER_DETAILS (CUSTOMER_ID),
	FOREIGN KEY (PRODUCT_ID)
        REFERENCES PRODUCT_DETAILS (PRODUCT_ID)
);

CREATE TABLE PRODUCT_SHIPMENT_MANAGER (
    PRODUCT_SHIPMENT_ID INT NOT NULL AUTO_INCREMENT,
    PRODUCT_ORDER_ID INT,
    PRODUCT_ID INT,
    CUSTOMER_ID INT,
    PENDING_QTY INT NOT NULL,
    ESPL_PO_OR_EBIS_NO VARCHAR(50),
    SUPPLIER_DELIVERY_DATE TIMESTAMP,
    INVOICE_NO VARCHAR(50),
    CREATED_BY VARCHAR(50),
    CREATED_DATE TIMESTAMP,
    MODIFIED_BY VARCHAR(50),
    MODIFIED_DATE TIMESTAMP,
    PRIMARY KEY (PRODUCT_SHIPMENT_ID),
    FOREIGN KEY (CUSTOMER_ID)
        REFERENCES CUSTOMER_DETAILS (CUSTOMER_ID),
    FOREIGN KEY (PRODUCT_ORDER_ID)
        REFERENCES PRODUCT_ORDER_MANAGER (PRODUCT_ORDER_ID),
	FOREIGN KEY (PRODUCT_ID)
        REFERENCES PRODUCT_DETAILS (PRODUCT_ID)
);
